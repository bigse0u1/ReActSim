{
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/outputs/**": true,
    "**/demos/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/outputs": true,
    "**/demos": true
  },
  "python.analysis.exclude": ["**/.venv", "**/outputs", "**/demos"],
  "python.analysis.indexing": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}
